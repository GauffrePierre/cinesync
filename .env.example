# Copie ce fichier en .env puis adapte les valeurs.
# Les clés des services (TMDB, Trakt, Plex, Seerr…) se saisissent dans la page Profil, pas ici.

# Version :
#   server   : un administrateur et les comptes de la famille, avec écran de connexion
#   personal : une seule personne, sans écran de connexion — à garder sur un réseau de confiance
#              (réseau local, Tailscale), jamais exposée directement sur Internet
CINESYNC_MODE=server

# Dossier de la base SQLite sur l'hôte (Unraid : /mnt/user/appdata/cinesync)
DATA_PATH=./data

# Port de l'interface sur l'hôte (à changer s'il est déjà pris)
CINESYNC_PORT=3000

# Adresse d'écoute : 0.0.0.0 = tout le réseau (HTTP simple).
# 127.0.0.1 = HTTPS uniquement, via un proxy installé sur le serveur (tailscale serve, voir README)
CINESYNC_BIND=0.0.0.0

# Propriétaire des fichiers de données : 1000:1000 sur la plupart des Linux (commande « id »),
# 99:100 (nobody:users) sur Unraid, 568:568 (apps) sur TrueNAS
PUID=1000
PGID=1000

# Fuseau horaire
TZ=Europe/Paris

# URL par laquelle tu ouvres SynCiné dans le navigateur, sans slash final.
# Sert à l'URL de retour OAuth Trakt ; en https://, les cookies de session sont toujours « Secure ».
# Exemple avec Tailscale serve : https://<machine>.<tailnet>.ts.net:8443
# Laisser vide = déduite automatiquement de la requête (OK en réseau local).
PUBLIC_URL=

# --- Réglages avancés (facultatifs) ---
# HSTS : le navigateur n'utilisera plus que le HTTPS pour ce domaine (domaine dédié, servi uniquement en HTTPS)
# HSTS_SECONDS=31536000
# Proxys inverses dont l'adresse du visiteur (X-Forwarded-For) est acceptée
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# Documentation interactive de l'API sur /api/docs
# API_DOCS=false

# Intervalle de vérification des disponibilités de la watchlist (heures)
NOTIFICATION_INTERVAL_HOURS=24

LOG_LEVEL=INFO
